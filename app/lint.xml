<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint baseline for this module. Two issues are intentionally ignored here, each
  with a reason, so that a clean `gradlew build` means "nothing new":

  1. ObsoleteSdkInt on res/mipmap-anydpi-v26 — lint suggests folding the folder into
     `mipmap-anydpi` because minSdk is 26, but AAPT *requires* <adaptive-icon> to sit
     in a -v26 folder; merging it up makes the build fail with
     "resource mipmap/ic_launcher not found".
  2. GradleDependency — the AGP/Gradle/Room/Material versions are pinned on purpose
     (see docs/plan.md 工具链锁定): this project must build on the course machine's
     offline mirror, so chasing "a newer version exists" would break reproducibility.
-->
<lint>
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
