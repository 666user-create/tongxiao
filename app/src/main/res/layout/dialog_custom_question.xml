<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_question_text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="120" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_question_options_title"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_question_option_1"
                android:inputType="text"
                android:maxLength="24" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_question_option_2"
                android:inputType="text"
                android:maxLength="24" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_question_option_3"
                android:inputType="text"
                android:maxLength="24" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_option_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_question_option_4"
                android:inputType="text"
                android:maxLength="24" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/custom_question_correct"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/custom_correct_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/custom_correct_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/custom_question_option_a" />

            <RadioButton
                android:id="@+id/custom_correct_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/custom_question_option_b" />

            <RadioButton
                android:id="@+id/custom_correct_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/custom_question_option_c" />

            <RadioButton
                android:id="@+id/custom_correct_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/custom_question_option_d" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
