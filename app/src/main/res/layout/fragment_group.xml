<?xml version="1.0" encoding="utf-8"?>
<!-- Step 5.5 dorm-group page skeleton (design.md §7 ④).
     Rows of the member and pending-request lists are added programmatically by
     GroupFragment, so this file only holds the static frame. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            app:title="@string/tab_group"
            app:titleTextColor="@color/green_primary" />

        <TextView
            android:id="@+id/group_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_scope_hint"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- State 1: not in a group yet -->
        <LinearLayout
            android:id="@+id/group_join_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_join_title"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/group_join_helper"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_create_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/group_create" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/group_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/group_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="6" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_join_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_join" />

        </LinearLayout>

        <!-- State 2: in a group -->
        <LinearLayout
            android:id="@+id/group_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/group_code_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/green_container"
                android:padding="14dp"
                android:textColor="@color/green_on_container"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_copy_code_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_code_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_nick_edit_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_nick_edit" />

            </LinearLayout>

            <TextView
                android:id="@+id/group_nick_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/group_share_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <!-- Settings total switch: every remote command is refused while it is off. -->
            <TextView
                android:id="@+id/group_master_off_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/green_container"
                android:padding="10dp"
                android:text="@string/group_master_off_banner"
                android:textColor="@color/green_on_container"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- NSD unavailable: explain why no roommate can be discovered. -->
            <TextView
                android:id="@+id/group_nsd_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/line"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/group_wiring_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/line"
                android:padding="10dp"
                android:text="@string/group_no_gateway_warning"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/group_members_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/group_member_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/group_member_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_member_empty"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/group_pending_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/group_pending_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/group_pending_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_pending_empty"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/group_op_log_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/group_op_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_leave_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/group_leave" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
