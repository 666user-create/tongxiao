<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/unlock_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="13sp"
        tools:text="第 1 / 2 题 · 答对才能停铃" />

    <TextView
        android:id="@+id/unlock_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="12 + 7 = ?" />

    <LinearLayout
        android:id="@+id/unlock_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opt_0"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opt_1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opt_2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opt_3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="17sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/unlock_shake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/green_primary"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="摇一摇停铃：3 / 5" />

    <TextView
        android:id="@+id/unlock_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/unlock_emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@android:color/transparent"
        android:text="@string/unlock_emergency"
        android:textColor="@color/muted"
        android:textSize="12sp" />

</LinearLayout>
