<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ only: windowLightNavigationBar is @RequiresApi(27).
         Kept out of default values/ so lint NewApi passes at minSdk 26. -->
    <style name="Theme.Tongxiao" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/green_on_primary</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_on_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <!-- Keep in lock-step with values/themes.xml: the two style definitions are
             whole-style overrides, so a role added in only one of them silently
             disappears on API 27+. -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/green_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
