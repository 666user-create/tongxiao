<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-locked: style 3 (Material 清新) is a light scheme; dark theme is out of v1 scope. -->
    <style name="Theme.Tongxiao" parent="Theme.Material3.Light.NoActionBar">
        <!-- Edge-to-edge on API 35+: status bar icons must be dark for the light scheme. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/green_on_primary</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_on_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
    </style>
</resources>
