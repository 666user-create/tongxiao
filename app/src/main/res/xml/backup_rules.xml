<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 counterpart of xml/data_extraction_rules.xml. Backups are off
  (android:allowBackup="false"), so this exists to state the same intent for older
  platforms and to keep the manifest self-consistent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
