<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms: SCHEDULE_EXACT_ALARM for Android 12/12L, USE_EXACT_ALARM for 13+
         (auto-granted to alarm-clock apps). Without either we fall back to inexact. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Ringing: foreground service + sound/vibration + keeping the device awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Registrations do not survive a reboot: rebuild them at boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Step 5.x dorm group: TCP peer links + NSD browse. NSD itself is a system
         service, but sockets (server and client, including 127.0.0.1 in tests)
         need INTERNET; both are normal permissions with no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tongxiao">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditAlarmActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CustomQuestionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.UnlockActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <!-- Full-screen stop screen: shown over the keyguard, so no lock-screen
             restrictions may be applied by the system theme. -->
        <activity
            android:name=".alarm.StopRingActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <!-- Explicit intents only (no intent-filter) => exported=false. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Boot / clock change / timezone change / app update: rebuild schedules. -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Read-only alarm sharing (design.md bonus item): other apps (and
             `adb shell content query`) can read the alarm list, but insert,
             update and delete are rejected inside the provider. Exported without
             a custom permission on purpose: the demo needs a query from a shell;
             the payload is non-sensitive schedule data and the provider refuses
             every write, which is the property lint cannot see. -->
        <provider
            android:name=".provider.AlarmProvider"
            android:authorities="com.course.tongxiao.alarms"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name=".alarm.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
